// Generated by ZINE vietnam-travel-guide
#let zine(
  body,
  paper: "a4",
  flipped: false,
  margin-top: 18mm,
  margin-right: 18mm,
  margin-bottom: 18mm,
  margin-left: 18mm,
  bleed: 0mm,
  font: "Avenir Next",
  pagination-enabled: true,
  pagination-position: "bottom-center",
) = {
  set page(
    paper: paper,
    flipped: flipped,
    margin: (
      top: margin-top,
      right: margin-right,
      bottom: margin-bottom,
      left: margin-left,
    ),
    bleed: bleed,
  )

  set text(
    font: font,
    size: 10.5pt,
  )

  set par(
    leading: 0.72em,
  )

  if pagination-enabled {
    set page(numbering: "1")
    let marker = if pagination-position == "top-left" {
      align(left)[counter(page).display("1")]
    } else if pagination-position == "top-center" {
      align(center)[counter(page).display("1")]
    } else if pagination-position == "top-right" {
      align(right)[counter(page).display("1")]
    } else if pagination-position == "bottom-left" {
      align(left)[counter(page).display("1")]
    } else if pagination-position == "bottom-right" {
      align(right)[counter(page).display("1")]
    } else {
      align(center)[counter(page).display("1")]
    }
    if str(pagination-position).starts-with("top-") {
      set page(header: marker)
    } else {
      set page(footer: marker)
    }
  }

  body
}

#let vertical_alignment(position) = {
  if position == "top" { top }
  else if position == "bottom" { bottom }
  else { horizon }
}

#let horizontal_alignment(position) = {
  if position == "left" { left }
  else if position == "right" { right }
  else { center }
}

// Text-only compositions are the only layouts that expose page alignment.
#let text_page_content(
  content,
  vertical: "center",
  horizontal: "center",
) = {
  block(
    width: 100%,
    height: 1fr,
    breakable: false,
  )[
    #align(
      horizontal_alignment(horizontal) + vertical_alignment(vertical),
    )[
      #block(width: 82%)[#content]
    ]
  ]
}

// Image and mixed compositions are always centered as a complete unit.
#let centered_page_content(content) = {
  block(
    width: 100%,
    height: 1fr,
    breakable: false,
  )[
    #align(center + horizon)[
      #block(width: 82%)[#content]
    ]
  ]
}

#let blank_page() = { [] }

#let title_page(
  title,
  subtitle: "",
  author: "",
  location: "",
  year: "",
  vertical: "center",
  horizontal: "center",
) = {
  let subtitle-content = if subtitle != "" {
    [#v(8mm) #text(size: 14pt)[#subtitle]]
  } else { [] }

  let author-content = if author != "" { [#author] } else { [] }
  let location-content = if location != "" { [#location] } else { [] }
  let year-content = if year != "" { [#year] } else { [] }

  text_page_content(
    vertical: vertical,
    horizontal: horizontal,
  )[
    #text(size: 28pt, weight: "bold")[#title]
    #subtitle-content
    #v(18mm)
    #author-content
    #location-content
    #year-content
  ]
}

#let photo_page(
  path,
  title: "",
  caption-text: "",
) = {
  let title-content = if title != "" {
    [#v(3mm) #text(weight: "bold")[#title]]
  } else { [] }

  let caption-content = if caption-text != "" {
    [#text(size: 8.5pt)[#caption-text]]
  } else { [] }

  centered_page_content[
    #image(
      path,
      width: 100%,
      height: 235mm,
      fit: "contain",
    )
    #title-content
    #caption-content
  ]
}

#let photos_2_page(a, b) = {
  centered_page_content[
    #grid(
      columns: 2,
      gutter: 6mm,
      image(a, width: 100%, fit: "contain"),
      image(b, width: 100%, fit: "contain"),
    )
  ]
}

#let photos_3_page(a, b, c) = {
  centered_page_content[
    #grid(
      columns: 3,
      gutter: 6mm,
      image(a, width: 100%, fit: "contain"),
      image(b, width: 100%, fit: "contain"),
      image(c, width: 100%, fit: "contain"),
    )
  ]
}

#let photos_4_page(a, b, c, d) = {
  centered_page_content[
    #grid(
      columns: 2,
      gutter: 6mm,
      image(a, width: 100%, fit: "contain"),
      image(b, width: 100%, fit: "contain"),
      image(c, width: 100%, fit: "contain"),
      image(d, width: 100%, fit: "contain"),
    )
  ]
}

#let text_page(
  title,
  body-text,
  vertical: "center",
  horizontal: "center",
) = {
  let title-content = if title != "" {
    [#text(size: 20pt, weight: "bold")[#title] #v(8mm)]
  } else { [] }

  text_page_content(
    vertical: vertical,
    horizontal: horizontal,
  )[
    #text(size: 12pt)[#title-content #body-text]
  ]
}

#let mixed_text(
  title,
  body-text,
  caption-text: "",
) = {
  let caption-content = if caption-text != "" {
    [#v(3mm) #text(size: 8.5pt)[#caption-text]]
  } else { [] }

  [
    #text(size: 18pt, weight: "bold")[#title]
    #v(5mm)
    #text[#body-text]
    #caption-content
  ]
}

#let photo_text_page(
  path,
  title,
  body-text,
  caption-text: "",
  text-position: "bottom",
) = {
  let text-content = mixed_text(
    title,
    body-text,
    caption-text: caption-text,
  )

  let composition = if text-position == "left" {
    grid(
      columns: (55mm, 68mm),
      gutter: 8mm,
      block(width: 55mm)[#text-content],
      image(path, width: 68mm, height: 145mm, fit: "contain"),
    )
  } else if text-position == "right" {
    grid(
      columns: (68mm, 55mm),
      gutter: 8mm,
      image(path, width: 68mm, height: 145mm, fit: "contain"),
      block(width: 55mm)[#text-content],
    )
  } else if text-position == "top" {
    stack(
      dir: ttb,
      spacing: 10mm,
      block(width: 140mm)[#text-content],
      image(path, width: 140mm, height: 82mm, fit: "contain"),
    )
  } else {
    stack(
      dir: ttb,
      spacing: 10mm,
      image(path, width: 140mm, height: 82mm, fit: "contain"),
      block(width: 140mm)[#text-content],
    )
  }

  centered_page_content[
    #composition
  ]
}

#let quote_page(
  quote-text,
  vertical: "center",
  horizontal: "center",
) = {
  text_page_content(
    vertical: vertical,
    horizontal: horizontal,
  )[
    #align(horizontal_alignment(horizontal))[
      #text(size: 24pt, style: "italic")[#quote-text]
    ]
  ]
}

#let chapter_page(
  title,
  subtitle: "",
  number: "",
) = {
  let subtitle-content = if subtitle != "" {
    [#v(8mm) #text(size: 14pt)[#subtitle]]
  } else { [] }

  text_page_content[
    #text(size: 12pt)[#number]
    #v(12mm)
    #text(size: 32pt, weight: "bold")[#title]
    #subtitle-content
  ]
}

#let contents_page(title: "Contents") = {
  block(width: 100%)[
    #text(size: 24pt, weight: "bold")[#title]
    #v(15pt)
    #outline(title: none, target: selector(heading.where(level: 1)))
  ]
}

