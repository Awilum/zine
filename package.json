{
  "name": "@awilum/zine",
  "version": "0.1.0",
  "description": "ZINE is an independent publishing engine for photographers, travelers and visual creators.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zine": "./src/cli/index.js"
  },
