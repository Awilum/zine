    "build:cli": "node scripts/build-cli.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "prettier": "^3.9.9"
  }
}
